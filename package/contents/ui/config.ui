<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>RememberAppMonitorConfigForm</class>
 <widget class="QWidget" name="RememberAppMonitorConfigForm">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="heading">
     <property name="text">
      <string>&lt;h3&gt;Press Meta+Ctrl+M to open the settings&lt;/h3&gt;&lt;p&gt;Apps, their sections and their remembered monitors are managed in the &lt;b&gt;Remember App Monitor&lt;/b&gt; window. KWin only allows a fixed form on this page, so it can't show that window or open it for you.&lt;/p&gt;&lt;p&gt;The shortcut can be changed in System Settings → Keyboard → Shortcuts → KWin → "Remember App Monitor: Open Settings".&lt;/p&gt;</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="manualGroup">
     <property name="title">
      <string>Manual entries (optional)</string>
     </property>
     <layout class="QVBoxLayout" name="manualLayout">
      <item>
       <widget class="QLabel" name="manualHelp">
        <property name="text">
         <string>&lt;p&gt;Only needed for apps the settings window can't list or pick. One per line: &lt;b&gt;window class = section&lt;/b&gt;, e.g. &lt;code&gt;steam = maximized&lt;/code&gt;. Lines starting with # are ignored. If an app is also in the window's list, the window's setting wins.&lt;/p&gt;&lt;p&gt;Sections: left, right, top, bottom, top-left, top-right, bottom-left, bottom-right, left-third, center-third, right-third, maximized, center, keep.&lt;/p&gt;</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPlainTextEdit" name="kcfg_apps">
        <property name="placeholderText">
         <string>steam = maximized</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
